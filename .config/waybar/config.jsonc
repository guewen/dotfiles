{
    "layer": "top",
    "include": [
        "/usr/share/sway/templates/waybar/config.jsonc"
    ],
    "modules-center": ["custom/wf-recorder", "sway/mode"],
    "modules-right": [
        // informational
        //"sway/language",
        //"custom/github",
        "custom/clipboard",
        //"custom/zeit",
        "cpu",
        "temperature",
        "memory",
        "battery",

        // connecting
        "network",
        "custom/vpn",
        "bluetooth",
        //"custom/valent",

        // media
        "custom/playerctl",
        "custom/idle_inhibitor",
        "custom/dnd",
        //"pulseaudio",
        "wireplumber",
        "backlight",

        // system
        //"custom/adaptive-light",
        //"custom/sunset",
        "custom/pacman",

        "tray",
        "clock"
    ],

    "wireplumber": {
        "format": "{volume}% {icon}",
        "format-muted": "",
        "on-click": "pavucontrol",
        "format-icons": ["", "", ""]
    },

    "custom/vpn": {
        "format": "VPN ",
        "exec": "echo '{\"class\": \"connected\"}'",
        "exec-if": "test -d /proc/sys/net/ipv4/conf/tun0",
        "return-type": "json",
        "interval": 5
    },
}
