{
    "include": [
        "/usr/share/sway/templates/waybar/config.jsonc"
    ],
    "modules-center": ["custom/wf-recorder", "sway/mode"],
    "modules-right": [
        // informational
        //"sway/language",
        //"custom/github",
        "custom/clipboard",
        //"custom/zeit",
        "cpu",
        "temperature",
        "memory",
        "battery",

        // connecting
        "network",
        "custom/vpn",
        "bluetooth",
        //"custom/valent",

        // media
        "custom/playerctl",
        "custom/notification",
        "custom/idle_inhibitor",
        //"pulseaudio",
        "wireplumber",
        "backlight",

        // system
        //"custom/adaptive-light",
        //"custom/sunset",
        "custom/pacman",

        "tray",
        "clock"
    ],

    "wireplumber": {
        "format": "{volume}% {icon}",
        "format-muted": "",
        "on-click": "pavucontrol",
        "format-icons": ["", "", ""]
    },

    "custom/vpn": {
        "format": "VPN ",
        "exec": "echo '{\"class\": \"connected\"}'",
        "exec-if": "test -d /proc/sys/net/ipv4/conf/tun0",
        "return-type": "json",
        "interval": 5
    },

    "custom/notification": {
        "tooltip": false,
        "format": "{} {icon}",
        "format-icons": {
            "notification": "<span foreground='red'><sup></sup></span>",
            "none": "",
            "dnd-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-none": "",
            "inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "inhibited-none": "",
            "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
}
